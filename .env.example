# Build-time image tag is artex:local; this only names the source tag we build.
ARTEX_VERSION=0.3.15

# Image name compose will run. Leave as artex:local to build here, or set a
# registry path (e.g. yourname/artex:0.3.15) to pull a prebuilt image instead.
ARTEX_IMAGE=artex:local

# 1 = install the distro Chromium for Playwright (~400MB added)
# 0 = no browser, agent falls back to Bash/HTTP only
WITH_CHROMIUM=1

# Postgres
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM: fill either one here, or leave blank and configure in the web UI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
